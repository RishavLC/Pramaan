# Copy to .env.local. Get a free key at https://dashboard.helius.dev
# Without a key the app falls back to the public devnet RPC (history will be limited).
VITE_HELIUS_API_KEY=YOUR_KEY

# Optional overrides (do NOT put any private key or wallet secret in these files)
# Full RPC URL; takes priority over the Helius key. Example: https://api.devnet.solana.com
VITE_SOLANA_RPC_URL=
# Optional: if set it must equal the program ID in src/idl/trust_bridge.json (a mismatch warning is shown on the dashboard).
VITE_PROGRAM_ID=
